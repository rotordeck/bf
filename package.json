{
  "name": "bf",
  "version": "0.1.0",
  "description": "Agent-oriented command line interface for configuring Betaflight flight controllers",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "bf": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
