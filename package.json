{
  "name": "@rotordeck/bf",
  "version": "0.1.0",
  "description": "Agent-oriented command line interface for configuring Betaflight flight controllers",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "bf": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "serialport": "^13.0.0",
    "usb": "^3.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotordeck/bf.git"
  },
  "homepage": "https://github.com/rotordeck/bf#readme",
  "bugs": {
    "url": "https://github.com/rotordeck/bf/issues"
  },
  "keywords": [
    "betaflight",
    "fpv",
    "drone",
    "msp",
    "cli",
    "configurator",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
